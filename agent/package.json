{
  "name": "@bcsa/agent",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "bcsa-agent": "./dist/index.js"
  },
  "scripts": {
    "build": "npm run build:native && tsc -p tsconfig.json",
    "build:native": "node scripts/build-native.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/index.ts",
    "start:built": "node dist/index.js",
    "test": "node --test --test-force-exit --import tsx \"./src/**/*.test.ts\""
  },
  "dependencies": {
    "@bcsa/shared": "*",
    "@fails-components/webtransport": "^1.6.7",
    "@fails-components/webtransport-transport-http3-quiche": "^1.6.7",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@peculiar/x509": "^1.14.3",
    "node-av": "^6.1.1",
    "screenshot-desktop": "^1.15.4",
    "selfsigned": "^2.4.1",
    "werift": "^0.24.1",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "@nut-tree-fork/node-mac-permissions": "^2.2.1",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
